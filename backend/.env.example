# 复制为 backend/.env 后填写配置。不要提交真实密钥。
# 旅行规划与地图外围接口均已使用 LangChain / MCP，不再依赖旧框架配置。

# 新入口优先读取 LLM_*，为空时逐项回退到 OPENAI_*。
# 需要支持 OpenAI-compatible Chat Completions 标准工具调用的模型。
# 新入口对 api.deepseek.com 使用非思考模式，以支持 ToolStrategy 强制工具输出。
LLM_MODEL_ID=your-model-name
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.openai.com/v1
# 单次模型请求超时（秒）。
LLM_TIMEOUT_SECONDS=90

# 如使用下面一组，先删除或留空上面三个 LLM_* 字段。
# OPENAI_MODEL=your-model-name
# OPENAI_API_KEY=your-llm-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# 高德 Web 服务 Key，后端映射为 MCP 需要的 AMAP_MAPS_API_KEY。
AMAP_API_KEY=your-amap-web-service-key
# 默认查找 uvx；找不到时可填写 uvx.exe 的绝对路径。
AMAP_MCP_COMMAND=uvx
# 单次 MCP 请求等待响应的超时，不等同于整个规划任务的超时。
MCP_TIMEOUT_SECONDS=30
# 同一次 POI 搜索补详情的间隔（秒），减少连续请求触发高德限频；不是全局限流。
AMAP_POI_DETAIL_INTERVAL_SECONDS=0.4

# 整次规划超时、每个查询 Agent 的真实调用上限、输出修复上限。
PLANNING_TIMEOUT_SECONDS=600
AGENT_MAX_TOOL_CALLS=3
PLAN_REPAIR_ATTEMPTS=1

HOST=0.0.0.0
PORT=8000
# 任务运行在当前进程中；启动规划服务时不要使用热重载或多个 worker。
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
LOG_LEVEL=INFO

# 原有图片服务，按需填写
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# 第 4 步：本地认证。请替换为随机长字符串，不要提交真实值。
# 可用 Python 生成：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=120

# 默认固定为 backend/data/trip_planner.db；一般无需配置。
# 测试或明确需要其他数据库时再取消注释。
# DATABASE_URL=sqlite:///E:/absolute/path/to/trip_planner.db
